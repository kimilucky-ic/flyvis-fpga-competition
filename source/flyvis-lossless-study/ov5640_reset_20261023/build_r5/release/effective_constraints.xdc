# User Generated miscellaneous constraints 

current_instance -quiet
set_property CLOCK_DEDICATED_ROUTE FALSE [get_nets cam_pclk_IBUF]
set_property ASYNC_REG true [get_cells flyvis_ddr_i/capture/inst/rst_n_d0_reg]
set_property ASYNC_REG true [get_cells flyvis_ddr_i/capture/inst/rst_n_syn_reg]

# User Generated XDC timing constraints 

set_false_path -to [get_pins {flyvis_ddr_i/capture/inst/rst_n_d0_reg/CLR flyvis_ddr_i/capture/inst/rst_n_syn_reg/CLR}]
set_false_path -to [get_pins -hier -filter {NAME =~ *camera_guard/inst/ar_reg*/CLR || NAME =~ *camera_guard/inst/pr_reg*/CLR || NAME =~ *camera_guard/inst/global_pr_reg*/CLR}]
set_input_delay -clock camera_pclk -clock_fall -min -0.500 [get_ports {{cam_data[*]} cam_href cam_vsync}]
set_input_delay -clock camera_pclk -clock_fall -max 2.000 [get_ports {{cam_data[*]} cam_href cam_vsync}]
set_clock_uncertainty -setup 0.250 [get_clocks camera_pclk]
set_clock_uncertainty -hold 0.100 [get_clocks camera_pclk]
set_max_delay -datapath_only -from [get_ports {cam_iic_scl_io cam_iic_sda_io}] 20.000
set_max_delay -datapath_only -from [all_registers -output_pins] -to [get_ports {cam_iic_scl_io cam_iic_sda_io}] 20.000

# Vivado Generated miscellaneous constraints 

#revert back to original instance
current_instance -quiet
